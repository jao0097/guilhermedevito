{
  "name": "superlista",
  "version": "2.2.0",
  "description": "Lista de compras inteligente com voz, teto de gastos e modo mercado (PWA offline).",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.input.css -o css/tailwind.css --watch",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.cjs",
    "start": "npx serve ."
  },
  "devDependencies": {
    "tailwindcss": "3.4.16"
  },
  "license": "MIT"
}
